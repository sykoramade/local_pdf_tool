# App URL — used for Stripe redirect URLs (never derived from request headers)
NEXT_PUBLIC_APP_URL=https://localpdf.tools

# Supabase — create a project at supabase.com, copy these from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe — required for /pricing and billing
# Create product + price at dashboard.stripe.com, copy IDs here
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Supabase service role key — used ONLY in webhook handler (server-side, never public)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
